# ==== Lulu RPG 环境变量示例 ====
# 复制为 .env 后按需修改。全部可留空使用演示模式。

# 应用
APP_PORT=8080

# 剧情写手（大模型）
# provider: mock（内置演示）| openai（任意 OpenAI 兼容接口）
LLM_PROVIDER=mock
# 例：http://ollama:11434/v1 或 http://host.docker.internal:8000/v1
LLM_BASE_URL=
LLM_API_KEY=
# 模型名，例如 qwen3:8b、Qwen2.5-32B-Instruct 等（按你的服务填写）
LLM_MODEL=
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=300

# 回合配图（OpenAI 兼容 /images/generations）
# 留空=关闭；设为 mock=内置占位画师；否则填模型名
IMG_MODEL=
IMG_BASE_URL=
IMG_API_KEY=
IMG_SIZE=1024x1024
IMG_STYLE_SUFFIX=幻想RPG概念艺术，数字绘画，电影感光影，丰富的细节

# 上下文与记忆
CONTEXT_RECENT_MESSAGES=20
CONTEXT_COMPACT_THRESHOLD=12
CONTEXT_MAX_TOKENS=6000
